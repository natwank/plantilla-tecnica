# Copia este archivo como .env.local y rellena los valores reales.
# .env.local no se commitea nunca; el agente tiene denegada su lectura.
# Aquí solo van NOMBRES de variables: sirve para saber qué necesita el proyecto.

# ─── Base de datos ─────────────────────────────────────────────
DATABASE_URL=

# ─── Autenticación ─────────────────────────────────────────────
AUTH_SECRET=

# ─── Servicios externos ────────────────────────────────────────
# NOMBRE_SERVICIO_API_KEY=

# ─── Aplicación ────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Servidores MCP ────────────────────────────────────────────
# Credenciales que usan los servidores declarados en .mcp.json como ${VARIABLE}.
# Una línea por servidor que necesite clave; los que usan OAuth no llevan nada.
# SUPABASE_ACCESS_TOKEN=
